rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user is an admin only if a document exists at admins/<their uid>.
    // Those documents can only be created from the Firebase console.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // The public website may only add a new lead. It cannot read, change or delete anything.
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'email', 'phone', 'service', 'property_type', 'message', 'status', 'source', 'created_at'])
        && request.resource.data.status == 'New'
        && request.resource.data.source == 'Website'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && (request.resource.data.message == null || request.resource.data.message.size() < 3000);
      allow read, update, delete: if isAdmin();
    }

    // ---- Learning library -------------------------------------------------
    // A learner is a signed-in user with a learners/<uid> document the admin has set to Approved.
    function isLearner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/learners/$(request.auth.uid))
        && get(/databases/$(database)/documents/learners/$(request.auth.uid)).data.status == 'Approved';
    }

    match /learners/{uid} {
      // Anyone signed in may request access for themselves; it starts as Pending.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'status', 'created_at'])
        && request.resource.data.status == 'Pending'
        && request.resource.data.name is string && request.resource.data.name.size() < 200;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    // Learners only ever see materials the admin has approved.
    match /materials/{id} {
      allow read: if isAdmin() || (isLearner() && resource.data.status == 'Approved');
      allow write: if isAdmin();
    }

    // The file itself, stored in pieces. Readable only while its material is approved.
    match /material_files/{id} {
      allow read: if isAdmin()
        || (isLearner() && get(/databases/$(database)/documents/materials/$(resource.data.material_id)).data.status == 'Approved');
      allow write: if isAdmin();
    }

    // The public website may read which theme to show; only admins can change it.
    match /site/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{collection}/{id} {
      allow read, write: if isAdmin()
        && collection in ['clients', 'staff', 'jobs', 'quotes', 'invoices', 'payments',
                          'inspections', 'rota', 'expenses', 'settings'];
    }
  }
}
