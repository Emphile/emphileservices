rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user is an admin only if a document exists at admins/<their uid>.
    // Those documents can only be created from the Firebase console.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // The public website may only add a new lead. It cannot read, change or delete anything.
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'email', 'phone', 'service', 'property_type', 'message', 'status', 'source', 'created_at'])
        && request.resource.data.status == 'New'
        && request.resource.data.source == 'Website'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && (request.resource.data.message == null || request.resource.data.message.size() < 3000);
      allow read, update, delete: if isAdmin();
    }

    match /{collection}/{id} {
      allow read, write: if isAdmin()
        && collection in ['clients', 'staff', 'jobs', 'quotes', 'invoices', 'payments',
                          'inspections', 'rota', 'expenses', 'settings'];
    }
  }
}
